# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Template for Mira Environment Variables
#  Copy this file to .env.local and fill in your actual credentials.
#  DO NOT commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Supabase Client Configuration (Public anon key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_APP_NAME=Mira

# 2. AI Provider API Keys (Server-side execution only — NEVER use VITE_ prefix)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 3. Azure Blob Storage (Optional — server-side only)
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_STORAGE_CONTAINER_NAME=mira-student-files
